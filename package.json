{
  "name": "handoff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "workspaces": [
    "apps/site"
  ],
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=.env build/apps/api/server.js",
    "test": "npm run compile && node --test build/tests/unit/*.test.js",
    "test:integration": "node --env-file-if-exists=.env --test --test-concurrency=1 build/tests/integration/*.test.js",
    "test:browser": "playwright test",
    "build": "npm run compile && npm run build --workspace apps/site",
    "verify": "node scripts/verify.mjs",
    "check:agent": "tsc -p tsconfig.agent.json",
    "eval:scripted": "node --env-file-if-exists=.env build/eval/harness/scripted.js",
    "eval:model": "node --env-file-if-exists=.env build/eval/harness/model.js",
    "eval:faults": "node --env-file-if-exists=.env build/eval/harness/faults.js",
    "check:site": "tsc -p apps/site/tsconfig.json"
  },
  "dependencies": {
    "eve": "1.0.0-rc.1",
    "pg": "8.23.1",
    "zod": "4.6.7",
    "@ai-sdk/openai-compatible": "3.0.82",
    "ai": "7.0.159"
  },
  "devDependencies": {
    "vite": "8.3.5",
    "typescript": "7.0.2",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@playwright/test": "1.64.1",
    "@fontsource/zilla-slab": "5.3.0",
    "@fontsource/asap": "5.3.0",
    "@fontsource/ubuntu-sans-mono": "5.3.0"
  }
}
