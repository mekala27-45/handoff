FROM node:24.19.0-bookworm-slim@sha256:a9f5f7c91a432850b2a8a7797adf5eadb6c733ceed61167806cee7ea7fbc29df AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/site/package.json ./apps/site/package.json
RUN npm ci --no-audit --no-fund
COPY tsconfig.json tsconfig.api.json ./
COPY packages ./packages
COPY apps/api ./apps/api
COPY reports/public ./reports/public
RUN npx tsc -p tsconfig.api.json
RUN npm prune --omit=dev --no-audit --no-fund
FROM node:24.19.0-bookworm-slim@sha256:a9f5f7c91a432850b2a8a7797adf5eadb6c733ceed61167806cee7ea7fbc29df
WORKDIR /app
ENV NODE_ENV=production PORT=80 HOST=0.0.0.0
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/build/packages ./build/packages
COPY --from=build /app/build/apps/api ./build/apps/api
COPY --from=build /app/packages/fixtures/data ./packages/fixtures/data
COPY --from=build /app/reports/public ./reports/public
USER node
EXPOSE 80
CMD ["node", "build/apps/api/server.js"]
